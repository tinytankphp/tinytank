{
    "name": "tinytank/tinytank",
    "description": "Starlite site skeleton: start a new site from here. The framework is the starlite/framework package.",
    "type": "project",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "vcs",
            "url": "https://github.com/lab909/starlite-framework"
        }
    ],
    "require": {
        "php": ">=8.4",
        "starlite/framework": "^0.1@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "deploy": "@php bin/console deploy",
        "cache:clear": "@php bin/console cache:clear",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}
