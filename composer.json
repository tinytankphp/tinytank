{
    "name": "tinytank/tinytank",
    "description": "TinyTank site skeleton: start a new site from here. The framework is the tinytank/framework package.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "require": {
        "php": ">=8.4",
        "tinytank/framework": "^0.1@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2",
        "phpunit/phpunit": "^12"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.4.0"
        }
    },
    "scripts": {
        "deploy": "@php bin/console deploy",
        "cache:clear": "@php bin/console cache:clear",
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "post-create-project-cmd": [
            "@php bin/create-site.php",
            "@composer update --lock --no-interaction --quiet"
        ]
    }
}
