# Copy to .env and fill in. Real environment variables (DDEV, PHP-FPM, nginx) override this file.

# Required: signs Datastar template configs.
# Generate with: openssl rand -hex 32
APP_SECRET=

# Required: public base URL (canonical links, Open Graph, sitemap, feed). No trailing slash.
APP_URL=https://example.com

# 1 = no caches, drafts visible, Vite dev server, Symfony exception pages. Leave empty/0 in production.
APP_DEBUG=0

# Optional: serve post and page files and video posters from a CDN that pulls them from this site
# (https only, no trailing slash). Empty: from this site, /media/…
# MEDIA_URL=https://cdn.example.com

# Email for forms (Symfony Mailer): how to send, and from which address (one of your own domain).
# The contact form goes to CONTACT_TO (comma-separated for several). DDEV sets these to its Mailpit.
# MAILER_DSN=smtp://user:pass@smtp.example.com:587
# MAILER_FROM=hello@example.com
# CONTACT_TO=you@example.com

# Optional: who gets an email when something breaks in production (comma-separated for several).
# Sent with MAILER_DSN/MAILER_FROM above, once per hour for the same error. Empty: no emails.
# LOG_ALERT_TO=you@example.com
# Optional: push alerts to your phone through Pushover (https://pushover.net), as well as or instead of
# email: errors, once per hour for the same one, and on a static site a form that couldn't be sent.
# The application's API token (create one at pushover.net/apps/build) and your user key; both or none.
# PUSHOVER_TOKEN=
# PUSHOVER_USER=
# Optional: the least important messages written to var/log/ (debug, info, notice, warning, error…).
# Default: debug when APP_DEBUG=1, info otherwise.
# LOG_LEVEL=info

# Optional: cache pages at a CDN (1 = on). Set this once the CDN is in front of the site.
# CDN_CACHE=1
# How deploy (and `bin/console cdn:purge`) clears the CDN: cloudflare, bunny or command. Empty: no
# purging, pages are kept 5 minutes instead of an hour. The tokens stay on the server, never in the frontend.
# CDN_PURGE=cloudflare
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=         # a token with the Cache Purge permission for this zone only
# BUNNY_PULL_ZONE_ID=
# BUNNY_API_KEY=
# CDN_PURGE_CMD=bin/purge-cdn   # gets the URLs as arguments, none for everything

# Optional: blog posts per page (default 20). A low value like 1 makes pagination easy to test.
# BLOG_PER_PAGE=20

# Optional: reverse proxies whose X-Forwarded-* headers are trusted (comma-separated IPs/CIDRs, or REMOTE_ADDR)
# APP_TRUSTED_PROXIES=

# Optional, for bin/console deploy: how to refresh the web server's Opcache (see README, "Production setups")
#   cachetool = PHP-FPM, precompile everything (default) | reload = run APP_OPCACHE_RELOAD_CMD | none
# APP_OPCACHE=cachetool
# APP_FPM_SOCKET=/run/php-fpm.sock
# APP_CACHETOOL=cachetool
# APP_OPCACHE_RELOAD_CMD="sudo systemctl reload php8.4-fpm"
