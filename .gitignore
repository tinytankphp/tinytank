/vendor/
/node_modules/
/public/build/
/public/media/
/var/cache/*
!/var/cache/.gitkeep
# The static build (bin/console build:static) and its own cache
/deploy/
/var/static-cache/
/var/vite.hot
# Encoded images (responsive versions, originals without metadata), reused across deploys
/var/images/
# Logs, kept on the server only (see config/app.php `log`)
/var/log/
/.ddev/.env*
.env
.env.*
!.env.example
/.idea
/var/phpunit/
/var/phpstan/
.ddev/docker-compose.myddev.local.yaml

# Maintainers only: local clones that replace the published repositories (see CONTRIBUTING.md).
# packages/* is picked up by Composer's path repository; the empty folder must stay committed.
/packages/*
!/packages/.gitkeep
/docs/
# Sites built alongside TinyTank, each its own repository (field tests): see CONTRIBUTING.md.
/sites/

# A new site commits its own lock file: remove this line after creating your site from the skeleton.
/composer.lock

# Playwright reports and traces
/test-results/
/playwright-report/
/analysis-report-2026-10-06
POSSIBLE_PLAN.md