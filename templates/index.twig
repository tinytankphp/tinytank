{% extends '_layout.twig' %}

{# The home page (HomeController): your site's front door. #}
{# example:start #}
{# The demos' own bundle, added by the layout after app.js. #}
{% set page_scripts = ['resources/js/pages/home.js'] %}
{# example:end #}

{% block content %}
    <h1 class="mb-2 text-3xl font-bold tracking-tight">{{ site.name }}</h1>
    <p class="mb-10 text-lg text-muted">{{ site.description }}</p>

    {# example:start #}
    {% include '_examples/home.twig' %}
    {# example:end #}

    {% set latest = posts().limit(3).all() %}
    {% if latest %}
        <section>
            <h2 class="mb-4 text-lg font-semibold">{{ 'Latest posts'|t }}</h2>
            <ul class="space-y-3">
                {% for post in latest %}
                    <li>
                        <a href="{{ path('blog_post', {slug: post.slug}) }}" class="font-medium hover:underline">{{ post.title }}</a>
                        <span class="text-sm text-subtle">· <time datetime="{{ post.date }}">{{ post.date|format_date('long', locale: site.locale) }}</time></span>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}
