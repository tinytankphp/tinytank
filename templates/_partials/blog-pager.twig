{#
    The blog's pager. Its pages are numbered links: crawlable, and they work without JavaScript.
    Search and tag results (`filtered`) have no URLs of their own, so they page with a "Load more"
    button instead (_partials/blog-more.twig, which replaces this pager).
#}
{% set filtered = filtered ?? false %}
{% set shown = min(result.page * result.per_page, result.total) %}
<nav id="blog-pager" aria-label="{{ 'Pagination'|t }}" class="mt-10 space-y-4 text-sm">
    {% if filtered and result.has_more %}
        <div class="flex items-center gap-4">
            <button data-on:click="$page = {{ result.page + 1 }}; {{ datastar.get('_partials/blog-more') }}"
                    data-indicator:loading data-attr:disabled="$loading"
                    class="rounded-md bg-primary px-4 py-2 text-on-primary hover:bg-primary-hover disabled:opacity-50">
                <span data-show="!$loading">{{ 'Load more'|t }}</span><span style="display: none" data-show="$loading">{{ 'Loading…'|t }}</span>
            </button>
            <span class="text-subtle">{{ '{shown} of {total} posts'|t({shown: shown, total: result.total}) }}</span>
        </div>
    {% endif %}

    {% if not filtered and result.pages > 1 %}
        <ul class="flex flex-wrap items-center gap-2">
            {% if result.page > 1 %}
                <li><a rel="prev" href="{{ result.page == 2 ? path('blog') : path('blog_page', {page: result.page - 1}) }}" class="hover:underline">{{ '← Newer'|t }}</a></li>
            {% endif %}
            {% for n in 1..result.pages %}
                {% if n == 1 or n == result.pages or (n - result.page)|abs <= 2 %}
                    <li>
                        {% if n == result.page %}
                            <span aria-current="page" class="rounded bg-primary px-2 py-1 text-on-primary">{{ n }}</span>
                        {% else %}
                            <a href="{{ n == 1 ? path('blog') : path('blog_page', {page: n}) }}" class="rounded px-2 py-1 hover:bg-chip">{{ n }}</a>
                        {% endif %}
                    </li>
                {% elseif n == 2 or n == result.pages - 1 %}
                    <li class="text-subtle">…</li>
                {% endif %}
            {% endfor %}
            {% if result.has_more %}
                <li><a rel="next" href="{{ path('blog_page', {page: result.page + 1}) }}" class="hover:underline">{{ 'Older →'|t }}</a></li>
            {% endif %}
        </ul>
    {% endif %}
</nav>
